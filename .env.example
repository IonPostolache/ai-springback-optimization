# LLM backend config -- generic OpenAI-compatible client, so this works
# unchanged whether you point it at Ollama on this machine, LM Studio on
# the Windows PC over the LAN, vLLM, etc. Only the base URL and model
# name change.

# LM Studio, running on the Windows 11 PC on the same network:
# 1. In LM Studio: Developer tab -> select model -> "Start Server" (default port 1234)
# 2. Find that PC's LAN IP (ipconfig on Windows -> IPv4 Address)
# 3. Confirm reachability first: curl http://<windows-pc-lan-ip>:1234/v1/models
LLM_BASE_URL=http://<windows-pc-lan-ip>:1234/v1
LLM_MODEL=<model-id-as-shown-by-GET-/v1/models>
LLM_API_KEY=lm-studio

# Local Ollama alternative (if you switch machines):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=not-needed-for-local-backends

